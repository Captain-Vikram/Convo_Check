{
  "collections": [
    {
      "collection": "habit_snapshots",
      "meta": {
        "icon": "timeline",
        "display_template": "{{ snapshot_id }}",
        "sort_field": "generated_at"
      }
    }
  ],
  "fields": [
    {
      "collection": "habit_snapshots",
      "field": "snapshot_id",
      "meta": {
        "interface": "input",
        "display": "formatted-value",
        "width": "half"
      }
    },
    {
      "collection": "habit_snapshots",
      "field": "owner",
      "meta": {
        "interface": "select-dropdown-m2o",
        "display": "related-values",
        "options": {
          "template": "{{ whatsapp_number || name || id }}"
        },
        "width": "half"
      }
    },
    {
      "collection": "habit_snapshots",
      "field": "generated_at",
      "meta": {
        "interface": "datetime",
        "display": "datetime",
        "width": "half"
      }
    },
    {
      "collection": "habit_snapshots",
      "field": "transaction_id",
      "meta": {
        "interface": "input",
        "display": "formatted-value",
        "width": "half"
      }
    },
    {
      "collection": "habit_snapshots",
      "field": "top_categories",
      "meta": {
        "interface": "code",
        "options": {
          "language": "json"
        },
        "display": "formatted-json",
        "width": "full"
      }
    },
    {
      "collection": "habit_snapshots",
      "field": "frequent_merchants",
      "meta": {
        "interface": "code",
        "options": {
          "language": "json"
        },
        "display": "formatted-json",
        "width": "full"
      }
    },
    {
      "collection": "habit_snapshots",
      "field": "spending_by_medium",
      "meta": {
        "interface": "code",
        "options": {
          "language": "json"
        },
        "display": "formatted-json",
        "width": "full"
      }
    },
    {
      "collection": "habit_snapshots",
      "field": "flags",
      "meta": {
        "interface": "tags",
        "display": "badges",
        "width": "half"
      }
    },
    {
      "collection": "habit_snapshots",
      "field": "insights_count",
      "meta": {
        "interface": "numeric",
        "display": "formatted-value",
        "width": "half"
      }
    },
    {
      "collection": "habit_snapshots",
      "field": "insight_labels",
      "meta": {
        "interface": "code",
        "options": {
          "language": "json"
        },
        "display": "formatted-json",
        "width": "full"
      }
    }
  ],
  "relations": [
    {
      "collection": "habit_snapshot_insights",
      "field": "snapshot",
      "meta": {
        "junction_field": "insight"
      }
    }
  ],
  "permissions": [
    {
      "role": "app_user",
      "collection": "habit_snapshots",
      "action": "read",
      "permissions": {
        "owner": {
          "_eq": "$CURRENT_USER"
        }
      },
      "fields": "*"
    },
    {
      "role": "app_user",
      "collection": "habit_snapshot_insights",
      "action": "read",
      "permissions": {
        "snapshot": {
          "_in": {
            "_select": {
              "collection": "habit_snapshots",
              "field": "id",
              "filter": {
                "owner": {
                  "_eq": "$CURRENT_USER"
                }
              }
            }
          }
        }
      },
      "fields": "*"
    }
  ]
}
